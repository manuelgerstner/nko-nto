# Example nginx config for standalone SSL (no reverse proxy in front).
# Requires:
#   - certs/nginx.crt and certs/nginx.key (TLS certificate + key)
#   - certs/dhparam.pem  (generate with: openssl dhparam -out certs/dhparam.pem 2048)
#   - A running 'letsencrypt' container on the same Docker network for ACME challenges
#
# Replace YOUR_DOMAIN with your actual domain, then rename this file to nginx.conf.

worker_processes 4;

events { worker_connections 1024; }

http {
    gzip on;
    gzip_vary on;
    gzip_min_length 10240;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/json application/javascript application/xml;
    gzip_disable "MSIE [1-6]\.";
    server_tokens off;
    client_max_body_size 100M;

    server {
        listen 443 ssl;
        listen [::]:443 ssl;
        include snippets/nginx-certs.conf;
        include snippets/nginx-ssl-params.conf;

        root /usr/share/nginx/html;
        include /etc/nginx/mime.types;
        index index.html index.htm;

        location /api {
            proxy_pass http://backend:10001;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location ~* \.(?:manifest|appcache|html?|xml|json)$ {
            expires -1;
        }

        location ~* \.(?:css|js)$ {
            try_files $uri =404;
            expires 1y;
            access_log off;
            add_header Cache-Control "public";
        }

        location ~ ^.+\..+$ {
            try_files $uri =404;
        }

        location / {
            limit_except GET HEAD POST PUT DELETE { deny all; }
            try_files $uri $uri/ /index.html;
        }
    }

    server {
        listen 80;
        listen [::]:80;
        server_name YOUR_DOMAIN;

        location /.well-known/acme-challenge {
            resolver 127.0.0.11 valid=30s;
            set $upstream letsencrypt;
            proxy_pass http://$upstream:80;
            proxy_set_header Host            YOUR_DOMAIN;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
        }

        location / {
            limit_except GET HEAD POST PUT DELETE { deny all; }
            return 301 https://YOUR_DOMAIN$request_uri;
        }
    }
}
