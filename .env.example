# Copy this file to .env and fill in your values before running docker compose up

# PostgreSQL
POSTGRES_PASSWORD=change-me

# Backend URL exposed to the frontend (your public domain)
VITE_API_BASE_URL=https://your-domain.com/api

# Firebase web app config (Firebase console → Project settings → Your apps → Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=
